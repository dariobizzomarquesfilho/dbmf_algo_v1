# DBMF Quant — Example environment file
# Copy to `config/.env` and fill in your own keys:  cp config/.env.example config/.env

# SEC EDGAR identity — REQUIRED (used by edgartools / edgar.set_identity)
# Format: "Full Name email@domain" — SEC rejects requests without it.
SEC_USER="Full Name email@domain"

# Backtest window — single source of truth
# Propagated as: config/.env -> config/config.py -> lean_project/data/backtest_config.py -> lean_project/lean.json
# After changing dates, re-run:  python lean_project/scripts/embed_data.py
BACKTEST_START="2011-01-01"
BACKTEST_END="2026-07-31"

# Warm-up days before BACKTEST_START for rolling indicators (beta, ATR)
# Default 252 trading days (~1 year). Increase if you use longer lookbacks.
BACKTEST_WARMUP_DAYS="252"

# Optional floor for how far back to fetch bars (default: earliest S&P 500 membership in CSV)
# BACKTEST_HISTORY_START="1996-01-02"

# Tiingo API key — fallback for delisted / renamed S&P 500 constituents not on Yahoo
# Free tier: 500 symbols/month, 1000 req/day. https://www.tiingo.com/
# Supports rotation: TIINGO_API_KEYS="key1,key2" or legacy TIINGO_API_KEY / TIINGO_API_KEY_1 / TIINGO_API_KEY_2
# TIINGO_API_KEY="your_tiingo_key_here"
# TIINGO_API_KEYS="key1,key2"

# FRED API key — optional, for macro data (currently not required for backtest)
# Get a free key at https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY="your_fred_key_here"
